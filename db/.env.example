# Configuración de la base de datos de CipolloLand.
# Copiar a `.env` y ajustar. `.env` está gitignored (contiene credenciales).
#
#   cp .env.example .env     (linux)
#   copy .env.example .env   (windows)

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Puerto de Adminer (GUI opcional, perfil "tools").
ADMINER_PORT=

# Para la app Next.js / Prisma. Pegar en el `.env` de la raíz del proyecto:
# DATABASE_URL="postgresql://cipolloland:cipolloland@localhost:5432/cipolloland?schema=public"